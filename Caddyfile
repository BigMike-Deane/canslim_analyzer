canslim.duckdns.org {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"

		# CSP: locked-down baseline.
		#
		# script-src: 'unsafe-inline' is here for the service-worker
		#   registration block in frontend/index.html and for Tailwind's
		#   runtime style insertion. Tightening this via a SHA-256 hash
		#   on the SW block (or moving it into the Vite bundle) is a
		#   follow-up — see canslim memory.
		# style-src: Tailwind injects inline <style>; 'unsafe-inline'
		#   is the only viable allowance until the build extracts CSS.
		# img-src https: keeps logos/charts working.
		# connect-src 'self' https://accounts.google.com — same-origin
		#   API + GIS endpoints. ntfy webhook URLs are server-to-server
		#   (not browser fetches) so they don't belong here.
		# frame-src https://accounts.google.com — Google Sign-In popup.
		# frame-ancestors 'none' duplicates X-Frame-Options DENY but is
		#   the modern primitive recognised by all current browsers.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com; frame-src 'self' https://accounts.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# Disable browser APIs the app doesn't use. If a future feature
		# needs one, add it explicitly to the allowlist instead of
		# loosening the policy.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
	}
	reverse_proxy canslim:8001
}
